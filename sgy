  const description = ((descriptionNode ? descriptionNode.innerText || descriptionNode.textContent : text) || '')
    .replace(/[ \\t]+/g, ' ').replace(/ *\\n */g, '\\n').replace(/\\n{3,}/g, '\\n\\n').trim();
