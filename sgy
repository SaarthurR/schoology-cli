# Class updates, the bell and the inbox. Every item carries `source`, so a class
# post never reads as a direct message. The home page draws its posts with
# JavaScript after load, so posts come from the /feed endpoints (JSON wrapping
# HTML) -- reading /home itself returns an empty shell.
INBOX_JS = """
async ({kinds, courses}) => {
  const get = async (u) => {
    // Many requests in a row trip Schoology's rate limit (429); wait and retry.
    for (let i = 0; i < 3; i++) {
      const r = await fetch(u, {credentials: 'include',
                                headers: {'X-Requested-With': 'XMLHttpRequest'}});
      if (r.status !== 429) return r.ok ? r.text() : '';
      await new Promise(res => setTimeout(res, 1500 * (i + 1)));
    }
    return '';
  };
  const parse = (h) => new DOMParser().parseFromString(h, 'text/html');
  const text = (e) => e ? e.textContent.replace(/\\s+/g, ' ').trim() : '';
  // Like text(), but keeps paragraph breaks so a post's first line can serve as its title.
  const lines = (e) => {
    if (!e) return '';
    e.querySelectorAll('br').forEach(b => b.replaceWith('\\n'));
    e.querySelectorAll('p,li').forEach(b => b.append('\\n'));
    return e.textContent.replace(/[ \\t\\u00a0]+/g, ' ').replace(/ *\\n\\s*/g, '\\n').trim();
  };
  const when = (s) => { const d = new Date(String(s).replace(' at ', ' '));
                        return isNaN(d) ? '' : d.toISOString(); };
  const feedDoc = async (u) => {
    try { return parse(JSON.parse(await get(u)).output || ''); } catch { return parse(''); }
  };
  const posts = (doc, fallback) => [...doc.querySelectorAll('li[id^="edge-assoc-"]')].map(li => {
    const inner = li.querySelector('.update-sentence-inner');
    const ts = Number(li.getAttribute('timestamp'));
    return {source: 'update', id: li.id, author: text(li.querySelector('.long-username')),
            course: text(inner && inner.querySelector('a[href^="/course/"],a[href^="/group/"]')) || fallback,
            body: lines(li.querySelector('.update-body')),
            at: ts ? new Date(ts * 1000).toISOString() : ''};
  });
  const out = {};
  if (kinds.includes('feed')) out.feed = posts(await feedDoc('/home/feed?page=0'), '');
  if (kinds.includes('updates')) {
    out.updates = [];
    for (const c of courses)
      out.updates.push(...posts(await feedDoc(`/course/${c.nid}/feed?page=0`), c.courseTitle));
  }
  if (kinds.includes('notifications')) {
    const LABEL = {'course-materials-add': 'New material', 'grade-add': 'Grade posted',
                   'comment-add': 'Reply'};
    out.notifications = [];
    let day = '';  // "Friday, September 11, 2026" -- the rows only say "Sep 11 at 2:56 pm"
    for (const li of parse(await get('/home/notifications'))
                       .querySelectorAll('ul.s-notifications-mini > li')) {
      if (li.classList.contains('notif-date-header')) { day = text(li); continue; }
      const sentence = li.querySelector('.edge-sentence');
      if (!sentence) continue;
      const type = (li.querySelector('[class*="s-edge-type-"]')?.className || '')
                     .match(/s-edge-type-([\\w-]+)/);
      const time = text(sentence.querySelector('.edge-time')).replace(/^.* at /, '');
      sentence.querySelectorAll('.edge-time,.visually-hidden').forEach(e => e.remove());
      out.notifications.push({source: 'notification',
        type: type ? (LABEL[type[1]] || type[1]) : 'Notification',
        // Only a bare /course/<id> link is the class; /course/<id>/materials/... is the item.
        course: text([...sentence.querySelectorAll('a[href]')]
                       .find(a => /^\\/course\\/\\d+$/.test(a.getAttribute('href')))),
        text: text(sentence),
        at: when(`${day.replace(/^\\w+, /, '')} ${time}`)});
    }
  }
  if (kinds.includes('messages')) {
    out.messages = [];
    const rows = parse(await get('/messages')).querySelectorAll('table.privatemsg-list tbody tr');
    for (const [i, tr] of [...rows].entries()) {
      const cell = tr.querySelector('.privatemsg-list-subject');
      if (!cell) continue;
      const link = cell.querySelector('.subject-link');
      const href = link ? link.getAttribute('href') : '';
      const subject = cell.getAttribute('subject') || text(link);
      let body = text(cell.querySelector('.privatemsg-list-body'));
      // The list only shows a cut-off preview; the newest few get one more request.
      if (href && i < 8) {
        const m = parse(await get(href)).querySelector('.message-body');
        if (m) { m.querySelector('.name')?.remove(); body = lines(m) || body; }
      }
      out.messages.push({source: 'message', id: href, subject, body,
        course: (subject.match(/^\\[([^\\]]+)\\]/) || [])[1] || '',
        author: text(tr.querySelector('.names-date a')),
        unread: tr.className.includes('unread'),
        at: when(text(tr.querySelector('.names-date .small')))});
    }
  }
  return out;
}
"""

COURSES_JS = """
async () => (await (await fetch('/iapi2/site-navigation/courses', {credentials: 'include',
  headers: {'X-Requested-With': 'XMLHttpRequest'}})).json()).data.courses
"""


# ---------------------------------------------------------------- config

def base():
    if not CONFIG.exists():
        sys.exit("Not set up yet. Run:  sgy setup")
    return json.loads(CONFIG.read_text())["base"]


def normalise(url):
    """Accept fuhsd.schoology.com, https://fuhsd.schoology.com/home, etc."""
    url = url.strip()
    if not url.startswith(("http://", "https://")):
        url = "https://" + url
    return "https://" + url.split("://", 1)[1].split("/")[0]


def looks_like_schoology(url):
    """Districts on Google/Microsoft SSO redirect /login straight to the identity
    provider, so check the landing URL as well as the body -- the word survives
    in the redirect's state parameter even when the page itself is Google's."""
    try:
        req = urllib.request.Request(url + "/login",
                                     headers={"User-Agent": "sgy"})
        with urllib.request.urlopen(req, timeout=15) as r:
            body = r.read(60000).decode("utf-8", "ignore").lower()
            return "schoology" in body or "schoology" in r.geturl().lower()
    except Exception:
        return False


# ---------------------------------------------------------------- helpers

def period_of(s):
    m = PERIOD.search(s or "")
    return int(m.group(1)) if m else None


def strip_tags(s):
    """Schoology double-encodes calendar titles, so unescape after stripping."""
    return html.unescape(re.sub(r"<[^>]+>", "", s or "")).strip()


def clean_course(name):
    """'Biology - 3110: HajjarianP p1 T1' -> 'Biology'."""
    return re.sub(r"\s+-\s+\d{3,}\b.*$", "", name or "").strip()


def when_local(iso):
    if not iso:
        return "(no date)".ljust(17)
    dt = datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone()
    return (f"{dt:%a %b} {dt.day} {dt.hour % 12 or 12}:{dt:%M}"
            f"{'am' if dt.hour < 12 else 'pm'}").ljust(17)


def signed_in(ctx):
    """Ask Schoology directly. The URL lies -- /home flashes up before the
    redirect to the identity provider, so a URL check declares victory early."""
    try:
        r = ctx.request.get(f"{base()}/iapi2/site-navigation/courses",
                            headers={"X-Requested-With": "XMLHttpRequest"})
        return r.ok and "json" in (r.headers.get("content-type") or "")
    except Exception:
        return False


# ---------------------------------------------------------------- setup

def ensure_browser():
    """Playwright ships no browser by default; fetch Chromium once."""
    marker = Path.home() / ".cache" / "ms-playwright"
    if marker.exists() and any(marker.glob("chromium*")):
        return
    print("Downloading Chromium (one time, ~150MB)...")
    subprocess.run([sys.executable, "-m", "playwright", "install", "chromium"],
                   check=True)


def link_onto_path():
    """Put `sgy` on PATH so it works from any directory."""
    target = Path(__file__).resolve()
    bindir = Path.home() / ".local" / "bin"
    if not bindir.is_dir():
        return None
    if str(bindir) not in os.environ.get("PATH", "").split(":"):
        return None
    link = bindir / "sgy"
    if link.exists() and link.resolve() == target:
        return link
    try:
        if link.exists() or link.is_symlink():
            link.unlink()
        link.symlink_to(target)
        return link
    except OSError:
        return None


def setup(argv):
    HOME.mkdir(parents=True, exist_ok=True)

    given = next((a for a in argv if not a.startswith("-")), None)
    while True:
        url = given or input(
            "Your school's Schoology address (e.g. fuhsd.schoology.com): ")
        given = None
        if not url.strip():
            continue
        url = normalise(url)
        print(f"Checking {url} ...")
        if looks_like_schoology(url):
            break
        print(f"  {url} doesn't look like a Schoology site. Try again.\n")

    CONFIG.write_text(json.dumps({"base": url}, indent=2))
    print(f"Saved {url}")

    ensure_browser()

    link = link_onto_path()
    print(f"Linked {link} -> you can run `sgy` from anywhere."
          if link else "Note: ~/.local/bin isn't on PATH, so run ./sgy from here.")

    print()
    if login() != 0:
        return 1
    print("\nDone. Try:  sgy classes")
    return 0


def login():
    HOME.mkdir(parents=True, exist_ok=True)
    PROFILE.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as pw:
        # channel="chrome": Google's login flags Playwright's bundled Chromium
        # as an untrusted automated browser and blocks sign-in immediately.
        # Real, installed Chrome doesn't get flagged.
        ctx = pw.chromium.launch_persistent_context(
            str(PROFILE), headless=False, channel="chrome")
        page = ctx.pages[0] if ctx.pages else ctx.new_page()
        page.goto(f"{base()}/home", wait_until="domcontentloaded")
        print("Sign in to Schoology in the window that just opened.")
        print("Waiting... (Ctrl-C to give up)")
        for _ in range(300):  # 10 minutes, checked every 2s
            if signed_in(ctx):
                ctx.storage_state(path=str(STATE))
                STATE.chmod(0o600)
                print("Signed in. Session saved.")
                ctx.close()
                return 0
            time.sleep(2)
        print("Timed out -- nothing saved.", file=sys.stderr)
        ctx.close()
        return 1


# ---------------------------------------------------------------- fetching

@contextmanager
def session():
    """A logged-in page on the Schoology home screen, plus your user id."""
    if not CONFIG.exists():
        sys.exit("Not set up yet. Run:  sgy setup")
    if not STATE.exists():
        sys.exit("Not logged in yet. Run:  sgy login")
    with sync_playwright() as pw:
        browser = pw.chromium.launch(headless=True)
        ctx = browser.new_context(storage_state=str(STATE))
        page = ctx.new_page()
        try:
            if not signed_in(ctx):
                sys.exit("Session expired. Run:  sgy login")
            page.goto(f"{base()}/home", wait_until="domcontentloaded")
            m = re.search(r'["\']uid["\']\s*:\s*["\']?(\d{6,})', page.content())
            if not m:
                sys.exit("Session expired. Run:  sgy login")
            yield page, m.group(1)
        finally:
            ctx.close()
            browser.close()


def load(days=30, updates=False):
    with session() as (page, uid):
        now = int(time.time())
        data = page.evaluate(FETCH_JS, {"uid": uid, "start": now,
                                        "end": now + days * 86400})
        if updates:
            data.update(page.evaluate(INBOX_JS, {
                "kinds": ["updates", "notifications", "messages"],
                "courses": data["courses"]}))
        return data


def page_text(path, page=None):
    """Any Schoology page as readable text. Deliberately generic: Schoology
    server-renders most of itself, and bespoke selectors for each screen would
    be guesswork that rots. This reads whatever the page actually says."""
    if page is None:
        with session() as (p, _):
            return page_text(path, p)
    return page.evaluate(READ_JS, path)


def graded_only(items, key, show_all):
    """Keep the real classes, in period order. If a district doesn't use period
    markers nothing would match, so fall back to returning everything.

    Anything hidden is REPORTED, never dropped silently -- a class whose section
    gets renamed would otherwise vanish from your grades with no sign."""
    if show_all:
        return items
    picked = [i for i in items if period_of(key(i)) is not None]
    if not picked:
        print("(no period markers found — showing everything)\n")
        return items
    hidden = len(items) - len(picked)
    if hidden:
        print(f"(showing {len(picked)} classes; {hidden} other enrolment(s) "
              f"hidden — `--all` to see them)\n")
    return sorted(picked, key=lambda i: period_of(key(i)))


# ---------------------------------------------------------------- commands

def cmd_classes(show_all):
    courses = graded_only(load()["courses"], lambda c: c["sectionTitle"], show_all)
    for c in courses:
        p = period_of(c["sectionTitle"])
        print(f"{('p%d' % p) if p else '  ':<4} "
              f"{c['courseTitle']:<32} {c['sectionTitle']}")


def cmd_grades(verbose, show_all):
    any_grade = False
    data = load()
    # A dash means "not posted". So does a broken parse, which is why an empty
    # or row-less result is an error rather than a quiet page of dashes.
    if not data["grades"]:
        sys.exit("Couldn't read the gradebook — Schoology's page layout has "
                 "probably changed. Don't trust any grade output until this is "
                 "fixed; check the site directly.")
    if data["grades"] and not any(g["rows"] for g in data["grades"]):
        sys.exit("Found your classes but no grade rows — the gradebook layout "
                 "has probably changed. Check the site directly.")
    for g in graded_only(data["grades"], lambda c: c["course"], show_all):
        rows = g["rows"]
        overall = next((r["grade"] for r in rows if r["kind"] == "course"), "—")
        if overall not in ("—", ""):
            any_grade = True
        print(f"\n{g['course']}   {overall}")
        if not verbose:
            continue
        # Schoology appends an empty "(no grading period)" bucket worth 0%.
        # Everything under it repeats the real term, so skip that whole section.
        skipping = False
        for r in rows:
            if r["kind"] == "period":
                skipping = "no grading period" in r["title"].lower()
            elif not skipping and r["kind"] in ("category", "item"):
                indent = "    " if r["kind"] == "category" else "      "
                print(f"{indent}{r['title'][:58]:<58} {r['grade']}")
    if not any_grade:
        print("\n(no grades posted yet)")


def due_at(e):
    """Schoology sends the hour in `start` and the minutes in a separate
    `minute_adjustment`, which has to be SUBTRACTED. An 11:59pm deadline
    arrives as start 23:00 with adjustment -59; reading `start` alone reports
    it an hour early."""
    s = e.get("start") or ""
    try:
        dt = datetime.strptime(s, "%Y-%m-%d %H:%M:%S")
    except ValueError:
        return s[:16] or "(no date)"
    adj = e.get("minute_adjustment")
    if adj:
        dt -= timedelta(minutes=int(adj))
    return dt.strftime("%Y-%m-%d %H:%M")


def cmd_due(days):
    events = sorted(load(days)["cal"], key=lambda e: e.get("start", ""))
    if not events:
        print(f"Nothing due in the next {days} days.")
        print(f"(only looked {days} days ahead — try `sgy due 60`)")
        return
    for e in events:
        print(f"{due_at(e)}  "
              f"{strip_tags(e.get('titleText'))[:52]:<52} "
              f"{e.get('content_title', '')[:30]}")
    print(f"\n{len(events)} item(s) in the next {days} days. "
          f"Anything later is not shown.")


def show(path, page=None):
    r = page_text(path, page)
    if r["status"] >= 400:
        sys.exit(f"Schoology returned {r['status']} for {path}")
    if r["json"]:
        print(json.dumps(json.loads(r["text"]), indent=2))
    else:
        print(r["text"] or "(page is empty)")


def detail(path):
    """Read one trusted Schoology item as structured local data."""
    with session() as (page, _):
        result = page.evaluate(DETAIL_JS, path)
    if result["status"] >= 400:
        sys.exit(f"Schoology returned {result['status']} for {path}")
    result["base"] = base()
    print(json.dumps(result))


def statuses(paths):
    """Check several assignment submission states through one signed-in browser."""
    with session() as (page, _):
        result = page.evaluate(STATUS_JS, paths)
    print(json.dumps(result))


def print_items(items, indent):
    for it in items:
        # /assignment/<id> and page items are readable text via `sgy page`;
        # documents open a viewer at /course/<nid>/materials/gp/<id> -- not
        # the file itself, see README for pulling the real attachment out.
        print(f"{indent}[{it['type']:<10}] {it['title'][:70]:<70} {it['href']}")


def pick_courses(courses, query):
    """A class by period number or part of its name; every enrolment if no query."""
    if not query:
        return courses
    q = query.lower()
    hits = [c for c in courses
            if q in c["courseTitle"].lower()
            or (q.isdigit() and period_of(c["sectionTitle"]) == int(q))]
    if not hits:
        sys.exit(f"No class matching {query!r}. Run `sgy classes` to list them.")
    return hits


def cmd_inbox(kind, query, as_json):
    with session() as (page, _):
        courses = pick_courses(page.evaluate(COURSES_JS), query) if kind == "updates" else []
        items = page.evaluate(INBOX_JS, {"kinds": [kind], "courses": courses})[kind]
    if as_json:
        print(json.dumps(items, indent=2))
        return
    if not items:
        print("(nothing here)")
    # Newest first. The bracket says which Schoology box it came from.
    for it in sorted(items, key=lambda i: i.get("at") or "", reverse=True):
        label = {"update": "Update", "message": "Message"}.get(it["source"]) or it.get("type")
        who = " · ".join(x for x in (clean_course(it.get("course")), it.get("author")) if x)
        body = it.get("body") or it.get("text", "").replace(it.get("course") or "\0",
                                                            clean_course(it.get("course")))
        if len(body) > 400:
            body = body[:400] + "…"
        print(f"{when_local(it.get('at'))} [{label}] {who}")
        if it.get("subject"):
            print(f"    {it['subject']}")
        for para in body.split("\n"):
            print(textwrap.fill(para, 96, initial_indent="    ", subsequent_indent="    "))
        print()


def cmd_materials(query):
    """Resolve a class by period number or name, then print its full
    materials tree -- every folder, walked, with the files/assignments
    inside each one. Not just the folder names."""
    with session() as (page, uid):
        courses = page.evaluate(COURSES_JS)
        if not query:
            print("Which class? Pass a period number or part of the name:\n")
            for c in courses:
                p = period_of(c["sectionTitle"])
                print(f"  {('p%d' % p) if p else '  ':<4} {c['courseTitle']}")
            return
        for c in pick_courses(courses, query):
            print(f"=== {c['courseTitle']} ===")
            tree = page.evaluate(MATERIALS_JS, {"nid": c["nid"]})
            if tree["topItems"]:
                print_items(tree["topItems"], "  ")
            for f in tree["folders"]:
                print(f"\n  {f['title']}/")
                if f["items"]:
                    print_items(f["items"], "    ")
                else:
                    print("    (empty)")


def main(argv):
    cmd = argv[0] if argv else "grades"
    show_all = "--all" in argv
    rest = [a for a in argv[1:] if not a.startswith("-")]
    if cmd == "setup":
        return setup(argv[1:])
    if cmd == "login":
        return login()
    if cmd == "classes":
        cmd_classes(show_all)
    elif cmd == "grades":
        cmd_grades(verbose="-v" in argv, show_all=show_all)
    elif cmd == "due":
        nums = [a for a in argv[1:] if a.isdigit()]
        cmd_due(int(nums[0]) if nums else 14)
    elif cmd == "json":
        print(json.dumps(load(updates="--updates" in argv), indent=2))
    elif cmd in ("updates", "notifications", "messages", "feed"):
        cmd_inbox(cmd, rest[0] if rest else None, "--json" in argv)
    elif cmd == "info":
        with session() as (page, uid):
            show(f"/user/{uid}/info", page)
    elif cmd == "materials":
        cmd_materials(rest[0] if rest else None)
    elif cmd == "page":
        if not rest:
            sys.exit("Which page? e.g.  sgy page /messages/sent")
        show(rest[0] if rest[0].startswith("/") else "/" + rest[0])
    elif cmd == "detail":
        if not rest:
            sys.exit("Which item? e.g.  sgy detail /assignment/12345")
        detail(rest[0] if rest[0].startswith("/") else "/" + rest[0])
    elif cmd == "statuses":
        if not rest:
            sys.exit("Which items? e.g.  sgy statuses /assignment/123 /assignment/456")
        statuses([item if item.startswith("/") else "/" + item for item in rest])
    else:
        sys.exit(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
