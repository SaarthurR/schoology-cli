STATUS_JS = """
async (paths) => {
  const results = [];
  for (const path of paths) {
    try {
      const r = await fetch(path, {credentials: 'include', headers: {'X-Requested-With': 'XMLHttpRequest'}});
      const body = await r.text();
      const doc = new DOMParser().parseFromString(body, 'text/html');
      const main = doc.querySelector('#main-inner,#center-top,#content,#main,body');
      const text = (main ? main.innerText || main.textContent : '').toLowerCase();
      const submittedNode = doc.querySelector('.submitted,.submission-status,.status-submitted,[data-submission-status="submitted"]');
      const submitted = Boolean(submittedNode) ||
        (/(submitted|turned in)/.test(text) && !/(not submitted|not turned in|unsubmitted|missing)/.test(text));
      results.push({path, submitted});
