#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["playwright"]
# ///
"""sgy — read your own Schoology grades, classes and due dates from the terminal.

Schoology's official API needs a key most districts don't hand out, and the
session cookie is httpOnly, so there's nothing to copy into a config file.
Instead sgy keeps its own logged-in Chrome profile and calls the same internal
JSON endpoints the Schoology web app calls. Read-only: it never writes to your
account.

    sgy setup [district-url]   one time, does everything
    sgy classes                your classes, in period order
    sgy grades [-v]            -v adds category weights and assignments
    sgy due [days]             what's due, defaults to 14
    sgy json                   raw data, for piping into other tools
    sgy login                  re-run when the session expires

Anything else you can see in a browser:

    sgy updates [class]        teachers' posts from each class's Updates section
    sgy notifications          the bell: new materials, grades posted, replies
    sgy messages               your inbox, with the full text of recent messages
    sgy feed                   the home feed (Recent Activity)
    sgy info                   your profile
    sgy materials [class]      a course's materials; no arg lists your classes
    sgy page <path>            ANY Schoology page, as readable text
    sgy detail <path>          an assignment/page description and its resource links

Add --all to classes or grades to include non-graded enrolments (school hubs,
counseling, advisory and the like). Add --json to updates, notifications,
messages or feed for raw data, and --updates to json to include all three.
"""
import html
import json
import os
import re
import subprocess
import sys
import textwrap
import time
import urllib.request
from contextlib import contextmanager
from datetime import datetime, timedelta
from pathlib import Path

from playwright.sync_api import sync_playwright

HOME = Path.home() / ".config" / "schoology-cli"
PROFILE = HOME / "chrome"       # keeps Google/SSO remembering you between logins
STATE = HOME / "state.json"     # Schoology's session cookie is memory-only, so
                                # Chrome never writes it to the profile on disk;
                                # storage_state is the only way to keep it.
CONFIG = HOME / "config.json"

# Districts name sections like "GreensteinD p5 T1". Real classes carry a period
# marker; hubs, counseling and advisory don't. Districts that don't use this
# convention simply match nothing, and we fall back to showing everything.
PERIOD = re.compile(r"\bp(\d)\b")

# Runs inside the page, so the httpOnly session cookie rides along automatically.
FETCH_JS = """
async ({uid, start, end}) => {
  const get = async (u) => {
    const r = await fetch(u, {credentials: 'include',
                             headers: {'X-Requested-With': 'XMLHttpRequest'}});
    return {status: r.status, text: await r.text()};
  };
  const clean = (e) => e ? e.textContent.replace(/\\s+/g, ' ').trim() : '';

  const courses = JSON.parse((await get('/iapi2/site-navigation/courses')).text);

  const gradesHtml = (await get('/grades/grades?id=' + uid)).text;
  const doc = new DOMParser().parseFromString(gradesHtml, 'text/html');
  // Screen-reader-only spans say "Course"/"Category"/"Grading Period" and would
  // otherwise glue onto every title as "HomeworkCategory (15%)".
  doc.querySelectorAll('.visually-hidden').forEach(e => e.remove());
  const grades = [...doc.querySelectorAll('.gradebook-course')].map(c => ({
    course: clean(c.querySelector('.gradebook-course-title')),
    rows: [...c.querySelectorAll('tr.report-row')].map(r => ({
      kind: (r.className.match(/(course|period|category|item)-row/) || [])[1] || '',
      title: clean(r.querySelector('.title-column')),
      grade: clean(r.querySelector('.grade-column')),
    })),
  }));

  // The path segment is ignored by Schoology; only start/end matter.
  const ym = new Date().toISOString().slice(0, 7);
  const cal = JSON.parse(
    (await get(`/calendar/${uid}/${ym}?ajax=1&start=${start}&end=${end}`)).text);

  return {courses: courses.data.courses, grades, cal};
}
"""

# Materials folders render their contents client-side, so the plain READ_JS
# text scrape sees folder names with nothing under them. This walks the real
# tree: the top page lists folder ids (`?f=<id>` links), then each folder page
# is fetched the same way to read its files/assignments.
MATERIALS_JS = """
async ({nid}) => {
  const get = async (u) => {
    const r = await fetch(u, {credentials: 'include',
                             headers: {'X-Requested-With': 'XMLHttpRequest'}});
    return await r.text();
  };
  const parse = (html) => new DOMParser().parseFromString(html, 'text/html');
  const path = `/course/${nid}/materials`;

  // A file's real title sits in .item-title for assignments/pages, or in
  // .attachments-file-name for plain uploaded documents -- .item-title is
  // present-but-empty on those, so it has to be the fallback, not first try.
  const readItems = (doc) => [...doc.querySelectorAll('tr.dr')].map(tr => {
    const type = (tr.className.match(/type-(\\w+)/) || [])[1] || '';
    const a = tr.querySelector('.item-title a') || tr.querySelector('.attachments-file-name a');
    return a ? {type, title: a.textContent.trim(), href: a.getAttribute('href')} : null;
  }).filter(Boolean);

  const topDoc = parse(await get(path));
  const folders = [...topDoc.querySelectorAll('tr.material-row-folder')].map(tr => {
    const a = tr.querySelector('.folder-title a');
    return {id: tr.id.replace('f-', ''), title: a ? a.textContent.trim() : '(untitled)'};
  });

  const tree = [];
  for (const f of folders) {
    const fDoc = parse(await get(`${path}?f=${f.id}`));
    tree.push({...f, items: readItems(fDoc)});
  }
  return {topItems: readItems(topDoc), folders: tree};
}
"""

# Reads any page as text. No per-screen selectors, so nothing to break when
# Schoology reshuffles a template.
READ_JS = """
async (path) => {
  const r = await fetch(path, {credentials: 'include',
                               headers: {'X-Requested-With': 'XMLHttpRequest'}});
  const body = await r.text();
  const ct = r.headers.get('content-type') || '';
  if (ct.includes('json')) return {status: r.status, json: true, text: body};

  const doc = new DOMParser().parseFromString(body, 'text/html');
  doc.querySelectorAll(
    'script,style,noscript,nav,header,footer,.visually-hidden,' +
    '#header,#footer,#left-nav,.sidebar').forEach(e => e.remove());
  const main = doc.querySelector('#main-inner,#center-top,#content,#main,body');
  const text = (main ? main.innerText || main.textContent : '')
    .replace(/[ \\t]+/g, ' ')
    .replace(/ *\\n */g, '\\n')
    .replace(/\\n{3,}/g, '\\n\\n')
    .trim();
  return {status: r.status, json: false, text};
}
"""

